# Porta de execução do servidor Express
PORT=5000

# String de Conexão com o Banco Relacional PostgreSQL
# Para Docker Local: postgresql://postgres:postgres@db:5432/barberpro
# Para Produção GCP: postgresql://usuario:senha@ip-do-cloud-sql:5432/barberpro
DATABASE_URL=postgresql://postgres:postgres@db:5432/barberpro

# Chave secreta de assinatura dos tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_para_cookies

# Token Estático para conexão segura do Power BI / Metabase
BI_TOKEN=barberpro_default_bi_secret_token_123

# Origem autorizada no CORS do cliente (Vite local)
CLIENT_ORIGIN=http://localhost:5173

# ID de cliente Google OAuth 2.0 (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
